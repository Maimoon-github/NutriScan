# NutriScan Phase 2 - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Django Settings
# ============================================
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# AI Services Configuration (Phase 2)
# ============================================

# Pinecone Vector Database (for RAG)
# Get your API key from: https://app.pinecone.io/
PINECONE_API_KEY='pcsk_2L6ZQV_52fJSeZjoWHE2yx7s2SWxDVhMkMqnS9DQUBWjeV4RgS581tpAhvfBELtGD5buL4'
PINECONE_ENVIRONMENT=us-east-1

# Ollama LLM Server
# Default: http://localhost:11434
# Change if running Ollama on a different machine
OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# Optional Services (Future Phases)
# ============================================

# AWS Textract (Phase 3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Google Cloud Vision (Phase 3)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# OpenAI (Alternative LLM - Phase 3)
# OPENAI_API_KEY=

# Gemini (Alternative LLM - Phase 3)
# GEMINI_API_KEY=

# ============================================
# Database (Production)
# ============================================
# For production, use PostgreSQL instead of SQLite
# DATABASE_URL=postgresql://user:password@localhost:5432/nutriscan

# ============================================
# Performance & Monitoring (Phase 3)
# ============================================
# REDIS_URL=redis://localhost:6379/0
# SENTRY_DSN=

# ============================================
# Notes
# ============================================
# 1. Minimum required for Phase 2:
#    - PINECONE_API_KEY (optional, system works without it)
#    - Ollama must be running: ollama serve
#
# 2. System will work in fallback mode without any environment variables
#
# 3. Never commit .env file with real credentials to version control

